<!-- JS -->
<script
        src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.9.10/dist/dotlottie-wc.js"
        type="module"
></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ once: true, duration: 700, offset: 60 });

    function previewFile(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => document.getElementById('previewImage').src = e.target.result;
        reader.readAsDataURL(file);
    }

    // Smooth anchor scroll
    document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
            const target = document.querySelector(a.getAttribute('href'));
            if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
        });
    });

    // Close mobile nav on item click
    document.querySelectorAll('#navbarContent .dropdown-item').forEach(item => {
        item.addEventListener('click', () => {
            const el = document.getElementById('navbarContent');
            const bsCol = bootstrap.Collapse.getInstance(el);
            if (bsCol) bsCol.hide();
        });
    });


    function closeSuccessAnimation()
    {
        const close = document.getElementById('popup');
        if (!close) return;
        close.style.transition = 'opacity 0.3 ease';
        close.style.opacity = '0';
        setTimeout(() => { close.style.display = 'none'; window.location.href='/user/home';},100);
    }
</script>

<script>
    AOS.init();

    const searchBox = document.getElementById("searchBox");
    const resultsDiv = document.getElementById("results");

    searchBox.addEventListener("keypress", function(e) {
        if (e.key === "Enter") {
            window.location.href = `/searchPage?keyword=${searchBox.value}`;
        }
    });

    const blockedWords = ["shirt", "jeans", "pant", "clothes", "shoes"];

    searchBox.addEventListener("input", function () {

        let keyword = searchBox.value.trim();

        if (keyword.length === 0) {
            resultsDiv.style.display = "none";
            return;
        }

        for (let word of blockedWords) {
            if (keyword.toLowerCase().includes(word)) {
                resultsDiv.innerHTML =
                "<div style='padding:10px;color:red;'>Invalid search ❌</div>";
                resultsDiv.style.display = "block";
                return;
            }
        }

        fetch(`/api/search?keyword=${keyword}`)
            .then(res => res.json())
            .then(data => {

            resultsDiv.innerHTML = "";

            if (data.length === 0) {
                resultsDiv.innerHTML =
                "<div style='padding:10px;'>No results found</div>";
            } else {

                data.forEach(item => {

                    let div = document.createElement("div");

                    div.style.display = "flex";
                    div.style.alignItems = "center";
                    div.style.padding = "10px";
                    div.style.borderBottom = "1px solid #eee";
                    div.style.cursor = "pointer";

                    let imgSrc = item.imageUrl
                        ? "data:image/jpeg;base64," + item.imageUrl
                        : "https://via.placeholder.com/50";

                    div.innerHTML = `
                            <img src="${imgSrc}" width="40" height="40"
                                 style="border-radius:5px; margin-right:10px;" />

                            <div>
                                <div style="font-weight:bold;">${item.name}</div>
                                <div style="font-size:12px; color:gray;">
                                    ${item.type}
                                </div>
                            </div>
                        `;

                    div.onclick = () => {
                        window.location.href = `/searchPage?keyword=${item.name}`;
                    };

                    resultsDiv.appendChild(div);
                });
            }

            resultsDiv.style.display = "block";
        });
    });


    document.addEventListener("click", function (e) {
        if (!searchBox.contains(e.target) && !resultsDiv.contains(e.target)) {
            resultsDiv.style.display = "none";
        }
    });
</script>

